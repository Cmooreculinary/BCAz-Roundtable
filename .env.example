# Root-level environment template — copy to .env and fill in your values.
# Never commit a real .env file.

# ── Backend ──────────────────────────────────────────────────────────────────
# SQLite database location
SQLITE_PATH=data/roundtable_vo.sqlite3

# Local file upload storage
UPLOAD_ROOT=data/uploads
MAX_UPLOAD_BYTES=52428800

# JWT signing secret (generate a strong random string)
JWT_SECRET=change_me_to_a_long_random_string

# First-run administrator seed (leave blank to disable)
ADMIN_EMAIL=admin@roundtable.app
ADMIN_PASSWORD=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Web Push (VAPID) — optional
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=you@example.com

# Twilio SMS — optional, leave blank to disable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Anthropic API key — optional, leave blank to disable Smart Suggestions
ANTHROPIC_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
REACT_APP_BACKEND_URL=http://localhost:8001
